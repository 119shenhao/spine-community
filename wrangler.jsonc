{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spine-community",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "GOOGLE_CLIENT_ID": "294338107553-k5bts5abj3tg85lt82moelv40sph3tuh.apps.googleusercontent.com",
    "PUBLIC_CONTENT_BASE_URL": "https://spine-data.nbn369.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spine-community-db",
      "database_id": "5919ff78-b8fc-46ab-85f0-01fe5e6a41b0",
      "migrations_dir": "migrations/v1"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "spine-community-db-preview",
        "database_id": "4362537a-5748-4a05-b0c4-219c3db36996",
        "migrations_dir": "migrations/v1"
      },
      {
        "binding": "IMPORT_DB",
        "database_name": "spine-community-db-preview",
        "database_id": "4362537a-5748-4a05-b0c4-219c3db36996",
        "migrations_dir": "migrations/v1"
      }
    ],
    "vars": {
      "APP_ENV": "preview",
      "GOOGLE_CLIENT_ID": "294338107553-bht5pr4qa112e9knbst517b0mvb9pus9.apps.googleusercontent.com",
      "TRANSLATION_ENABLED": "false",
      "IMPORT_ENABLED": "true",
      "COLLECT_ENABLED": "true",
      "PUBLIC_CONTENT_ENABLED": "true",
      "PUBLIC_CONTENT_READS": "true",
      "PUBLIC_CONTENT_FALLBACK": "true",
      "PUBLIC_CONTENT_BASE_URL": "https://spine-data-dev.nbn369.com"
    },
    "r2_buckets": [
      {
        "binding": "PUBLIC_CONTENT_R2",
        "bucket_name": "spine-community-public-dev"
      }
    ]
  },
  "build": {
    "command": "node scripts/prepare-build.mjs"
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_CONTENT_R2",
      "bucket_name": "spine-community-public-prod"
    }
  ]
}
