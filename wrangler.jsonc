{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spine-community",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
  // D1 binding deliberately not included until the owner provides the real
  // database_id. See README.md. Never invent a database UUID.
}
